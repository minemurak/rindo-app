# 署名・ビルド・TestFlight送信の手順

APP_ID = "com.minemurak.ridomap"

default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 初回だけ変数 MATCH_READONLY=false で実行し、証明書とプロファイルを作る
    match(api_key: api_key, readonly: ENV["MATCH_READONLY"] != "false")

    profile_name = ENV["sigh_#{APP_ID}_appstore_profile-name"]

    update_code_signing_settings(
      path: "RindoApp.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "RindoApp.xcodeproj",
      scheme: "RindoApp",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile_name } },
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER']}"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
