# 署名・ビルド・TestFlight送信の手順

APP_ID = "com.minemurak.rindomap"

require "base64"

# ASC_KEY_CONTENT には .p8 の中身をそのまま貼っても、Base64 にしたものでもよい。
# どちらでも、-----BEGIN PRIVATE KEY----- で始まる鍵の文字列に直して返す。
def asc_private_key
  raw = ENV["ASC_KEY_CONTENT"].to_s.strip
  UI.user_error!("Secret ASC_KEY_CONTENT が空です") if raw.empty?

  text = raw.include?("BEGIN PRIVATE KEY") ? raw.dup : Base64.decode64(raw)
  text.force_encoding("UTF-8") unless text.include?("\0")

  # Windows のメモ帳などで UTF-16 として保存されたファイルにも対応する
  if text.include?("\0")
    text = text.dup.force_encoding("UTF-16LE").encode("UTF-8", invalid: :replace, undef: :replace, replace: "")
  end
  text = text.scrub("").sub("﻿", "").gsub("\r\n", "\n").strip

  unless text.include?("BEGIN PRIVATE KEY") && text.include?("END PRIVATE KEY")
    UI.user_error!("ASC_KEY_CONTENT が .p8 の鍵として読めません。.p8 をメモ帳で開き、" \
                   "-----BEGIN PRIVATE KEY----- から -----END PRIVATE KEY----- までを丸ごと登録し直してください")
  end
  text + "\n"
end

default_platform(:ios)

platform :ios do
  lane :beta do
    # 初回だけ、手動実行で「証明書とプロファイルを新しく作る」にチェックして実行する。
    # setup_ci が MATCH_READONLY を true に書き換えるため、必ずその前に読む。
    create_certs = ENV["MATCH_READONLY"].to_s.strip.downcase == "false"
    UI.important(create_certs ? "証明書を作成するモードで実行します" : "証明書は読み取りのみで実行します")

    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"].to_s.strip,
      issuer_id: ENV["ASC_ISSUER_ID"].to_s.strip,
      key_content: asc_private_key,
      is_key_content_base64: false
    )

    # 証明書を作り直すとき（チェックを入れて実行）は、プロファイルも作り直す。
    # App ID に機能（Apple でサインインなど）を足したあとは、これで新しいプロファイルになる
    match(api_key: api_key, readonly: !create_certs, force: create_certs)

    profile_name = ENV["sigh_#{APP_ID}_appstore_profile-name"]

    update_code_signing_settings(
      path: "RindoApp.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "RindoApp.xcodeproj",
      scheme: "RindoApp",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile_name } },
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER']}"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
